load("@rules_go//go:def.bzl", "go_binary", "go_library")

filegroup(
    name = "dist_files",
    srcs = glob(["dist/**"]),
    visibility = ["//visibility:public"],
)

go_library(
    name = "server_lib",
    srcs = ["main.go"],
    embedsrcs = [
        "dist/assets/index-C0xZf2RS.css",
        "dist/assets/index-D12ISYQh.js",
        "dist/index.html",
    ],
    importpath = "github.com/spencerjireh/githelp/backend/cmd/server",
    visibility = ["//visibility:private"],
    deps = [
        "//backend/internal/api",
        "//backend/internal/auth",
        "//backend/internal/db",
        "//backend/internal/github",
    ],
)

go_binary(
    name = "githelp",
    embed = [":server_lib"],
    visibility = ["//visibility:public"],
)
